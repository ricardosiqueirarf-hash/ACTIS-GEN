# Local gateway. Upstream OAuth/provider credentials stay inside 9Router.
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=

# Required for execution. Discover exact IDs with meuharness-smoke --list-models.
# A catalog entry alone does not prove that the provider account can serve it.
NINEROUTER_MODEL=

# Per-stage smoke deadline. HarnessRequest.timeout_s controls application executions.
NINEROUTER_TIMEOUT_SECONDS=30
